# Supabase configuration
# Copy this file to .env and fill in your actual values
VITE_SUPABASE_PROJECT_ID="your-supabase-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-key"
VITE_SUPABASE_URL="https://your-supabase-project-id.supabase.co"

# Web Push (VAPID) public key — safe to expose client-side.
# Generate a pair with: npx web-push generate-vapid-keys
# The private half goes ONLY in Supabase Edge Function secrets (VAPID_PRIVATE_KEY), never here.
VITE_VAPID_PUBLIC_KEY="your-vapid-public-key"

# Supabase Edge Functions secrets
# Set these via: supabase secrets set --env-file supabase/functions/.env
# Or individually: supabase secrets set STRIPE_SECRET_KEY=sk_live_...
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Stripe configuration (required for payment Edge Functions)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# AI translation, Stella's call-answering intelligence, chatbot (Lovable AI gateway)
LOVABLE_API_KEY="your-lovable-api-key"

# Stella's voice synthesis during phone calls
ELEVENLABS_API_KEY="your-elevenlabs-api-key"

# Web Push private key (server-side only, never exposed to the client)
VAPID_PRIVATE_KEY="your-vapid-private-key"
